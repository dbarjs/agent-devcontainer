{
	"name": "agent-devcontainer node (prebuild)",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"mounts": [
		{
			"source": "pnpm-store",
			"target": "/home/vscode/.local/share/pnpm-store",
			"type": "volume"
		}
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"johnsoncodehk.vscode-tsconfig-helper",
				"antfu.pnpm-catalog-lens",
				"VoidZero.vite-plus-extension-pack",
				"usernamehw.errorlens",
				"naumovs.color-highlight"
			],
			"settings": {
				"errorLens.enabledDiagnosticLevels": ["warning", "error"],
				"errorLens.excludeBySource": ["cSpell", "eslint"],
				"prettier.enable": false,
				"prettier.printWidth": 200,
				"prettier.semi": false,
				"prettier.singleQuote": true
			}
		}
	},
	"containerEnv": {
		// keep ni deterministic in headless/agent sessions: fall back to pnpm
		// instead of prompting when a project has no lockfile or packageManager
		"NI_DEFAULT_AGENT": "pnpm",
		// corepack fetches project-pinned pnpm/yarn versions without prompting
		"COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
	},
	"remoteUser": "vscode"
}
