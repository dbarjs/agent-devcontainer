{
	"name": "agent-devcontainer base (prebuild)",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "../.."
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		}
	},
	"mounts": [
		{
			"source": "command-history",
			"target": "/home/vscode/.local/state/history",
			"type": "volume"
		},
		{
			"source": "identity",
			"target": "/home/vscode/.local/share/identity",
			"type": "volume"
		},
		{
			"source": "claude-config",
			"target": "/home/vscode/.claude",
			"type": "volume"
		},
		{
			"source": "gh-config",
			"target": "/home/vscode/.config/gh",
			"type": "volume"
		},
		{
			"source": "claude-install",
			"target": "/home/vscode/.local/share/claude",
			"type": "volume"
		},
		{
			"source": "claude-bin",
			"target": "/home/vscode/.local/bin",
			"type": "volume"
		}
	],
	"onCreateCommand": "/usr/local/share/agent-devcontainer/claude-bootstrap.sh",
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"DISABLE_AUTOUPDATER": "1"
	},
	"remoteUser": "vscode"
}
