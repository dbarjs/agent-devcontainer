#!/usr/bin/env zsh
# adc — agent-devcontainer CLI.
# Reaches users two ways: baked into the prebuilt images at /usr/local/bin,
# and on the host via the repo's Sheldon plugin (adc.plugin.zsh).
emulate -L zsh
set -eu
set -o pipefail

script_dir="${0:A:h}"

# The vendored templates, wherever this copy of adc lives: next to the script
# in a repo checkout (Sheldon plugin), or at the shared path baked into images.
# Each variant lives at <dir>/<variant>/devcontainer.json.
template_dirs=(
	"${script_dir:h}/templates"
	"/usr/local/share/adc/templates"
)

identity_repo_default="git@github.com:dbarjs/identity.git"
identity_dir="$HOME/.local/share/identity"
claude_install_dir="$HOME/.local/share/claude"
claude_bootstrap="/usr/local/share/agent-devcontainer/claude-bootstrap.sh"
op_agent_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

die() {
	print -ru2 -- "adc: $1"
	exit 1
}

usage() {
	cat <<'EOF'
adc — agent-devcontainer CLI

Usage: adc <command> [args]

Commands:
  init [dir] [--variant base|node] [--force]
                        Write the devcontainer template into a project
                        (default: current directory). Variant auto-detected:
                        package.json -> node, else base.
  identity sync         Clone-or-pull the identity repo onto the identity
                        volume, then apply (container only)
  identity apply        Copy identity files from the volume into place,
                        offline (container only)
  claude upgrade        Bootstrap or upgrade the shared Claude Code install
                        (container only)
  doctor                Pass/fail checks for this environment, with fixes

Environment:
  ADC_IDENTITY_REPO     Identity repo clone URL
                        (default: git@github.com:dbarjs/identity.git)
EOF
}

identity_usage() {
	cat <<'EOF'
adc identity — git + SSH identity in containers

Usage: adc identity <command>

Commands:
  sync   Clone-or-pull the identity repo onto the identity volume, then
         apply (runs over the forwarded SSH agent; container only)
  apply  Copy identity files from the volume into place, offline
         (container only)
EOF
}

claude_usage() {
	cat <<'EOF'
adc claude — the shared Claude Code install

Usage: adc claude <command>

Commands:
  upgrade  Bootstrap Claude Code onto the shared install volume if empty,
           otherwise upgrade it (container only)
EOF
}

# ---------------------------------------------------------------------------
# environment detection

in_container() {
	[[ -f /.dockerenv || -f /run/.containerenv || -n "${REMOTE_CONTAINERS:-}" || -n "${CODESPACES:-}" ]]
}

# identity sync/apply and claude upgrade manage container-side state (~/.ssh,
# ~/.config/git, the shared install volume); on the host they would clobber
# the real ones.
require_container() {
	in_container || die "'$1' runs inside a container only — on the host it would overwrite ~/.ssh and ~/.config/git"
}

# True when an SSH agent is reachable: ssh-add -l exits 0 (keys) or 1 (no
# keys); 2 means no agent behind the socket.
agent_alive() {
	[[ -S "${SSH_AUTH_SOCK:-}" ]] || return 1
	local rc=0
	ssh-add -l >/dev/null 2>&1 || rc=$?
	(( rc != 2 ))
}

# ---------------------------------------------------------------------------
# init

find_template() {
	local variant="$1" dir
	for dir in "${template_dirs[@]}"; do
		if [[ -f "$dir/$variant/devcontainer.json" ]]; then
			print -r -- "$dir/$variant/devcontainer.json"
			return 0
		fi
	done
	return 1
}

cmd_init() {
	local force=0 target="" variant="" arg
	while (( $# )); do
		arg="$1"
		shift
		case "$arg" in
			-f|--force) force=1 ;;
			--variant)
				(( $# )) || die "init: --variant needs a value (base|node)"
				variant="$1"
				shift
				;;
			--variant=*) variant="${arg#--variant=}" ;;
			-h|--help) usage; return 0 ;;
			-*) die "init: unknown option '$arg'" ;;
			*)
				[[ -n "$target" ]] && die "init: expected at most one directory argument"
				target="$arg"
				;;
		esac
	done
	if [[ -n "$variant" && "$variant" != base && "$variant" != node ]]; then
		die "init: unknown variant '$variant' (expected base or node)"
	fi

	target="${target:-$PWD}"
	[[ -d "$target" ]] || die "init: '$target' is not a directory"
	target="${target:A}"

	if [[ -n "$variant" ]]; then
		print -r -- "variant: $variant — --variant"
	elif [[ -f "$target/package.json" ]]; then
		variant=node
		print -r -- "variant: node — package.json found"
	else
		variant=base
		print -r -- "variant: base — no package.json"
	fi

	local name="${target:t}"
	local dest="$target/.devcontainer/devcontainer.json"
	if [[ -e "$dest" && $force -eq 0 ]]; then
		die "init: $dest already exists (use --force to overwrite)"
	fi

	local template
	template="$(find_template "$variant")" || die "init: vendored $variant template not found (looked in: ${(j:, :)template_dirs})"

	mkdir -p "${dest:h}"
	local content
	content="$(<"$template")"
	print -r -- "${content//<project-name>/$name}" > "$dest"

	print -r -- "Wrote $dest (name: $name)"
	print -r -- "Open the project in VS Code and \"Reopen in Container\"."
}

# ---------------------------------------------------------------------------
# identity sync / apply

cmd_identity_sync() {
	require_container "identity sync"
	agent_alive || die "identity sync: no SSH agent on SSH_AUTH_SOCK — the clone runs over the forwarded 1Password agent.
Fix: on the Mac, export SSH_AUTH_SOCK to the 1Password socket in ~/.zshrc
(see the dbarjs/identity README), then rebuild the container connection."

	local repo="${ADC_IDENTITY_REPO:-$identity_repo_default}"
	if [[ -d "$identity_dir/.git" ]]; then
		print -r -- "identity sync: updating identity clone at $identity_dir"
		git -C "$identity_dir" pull --ff-only
	else
		print -r -- "identity sync: cloning $repo -> $identity_dir"
		# accept-new: fresh containers have no known_hosts yet; changed keys still fail
		GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new" \
			git clone "$repo" "$identity_dir"
	fi
	cmd_identity_apply
}

cmd_identity_apply() {
	require_container "identity apply"
	[[ -d "$identity_dir/.git" ]] || die "identity apply: no identity clone at $identity_dir — run 'adc identity sync' first"

	if [[ -d "$identity_dir/ssh" ]]; then
		mkdir -p "$HOME/.ssh"
		cp -R "$identity_dir/ssh/." "$HOME/.ssh/"
		find "$HOME/.ssh" -type d -exec chmod 700 {} +
		find "$HOME/.ssh" -type f -exec chmod 600 {} +
		print -r -- "identity apply: ssh/ -> ~/.ssh (700/600)"
	fi

	if [[ -d "$identity_dir/git" ]]; then
		mkdir -p "$HOME/.config/git"
		cp -R "$identity_dir/git/." "$HOME/.config/git/"
		print -r -- "identity apply: git/ -> ~/.config/git/"
	fi

	print -r -- "identity apply: done"
}

# ---------------------------------------------------------------------------
# claude upgrade

cmd_claude_upgrade() {
	require_container "claude upgrade"
	if [[ -z "$(ls -A "$claude_install_dir" 2>/dev/null)" ]]; then
		print -r -- "claude upgrade: shared install volume is empty; bootstrapping Claude Code"
		if [[ -x "$claude_bootstrap" ]]; then
			"$claude_bootstrap"
		else
			curl -fsSL https://claude.ai/install.sh | bash
		fi
	else
		# every container mounting the shared volume gets this upgrade
		local claude_bin
		claude_bin="$(command -v claude)" || claude_bin="$HOME/.local/bin/claude"
		[[ -x "$claude_bin" ]] || die "claude upgrade: install volume is non-empty but no claude binary at $claude_bin"
		"$claude_bin" update
	fi
}

# ---------------------------------------------------------------------------
# doctor

doctor_failures=0

check() {
	local name="$1" fix="$2"
	shift 2
	if "$@" >/dev/null 2>&1; then
		print -r -- "  ok    $name"
	else
		print -r -- "  FAIL  $name"
		print -r -- "        fix: $fix"
		doctor_failures=$(( doctor_failures + 1 ))
	fi
}

have_claude() {
	command -v claude >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/claude" ]]
}

sock_is_1password() {
	[[ "${SSH_AUTH_SOCK:-}" == "$op_agent_sock" && -S "$op_agent_sock" ]]
}

cmd_doctor() {
	if in_container; then
		print -r -- "adc doctor (container)"
		check "SSH agent forwarded" \
			"export SSH_AUTH_SOCK to the 1Password socket on the host, then rebuild the container connection" \
			agent_alive
		check "identity applied (~/.ssh/config)" \
			"run 'adc identity sync' (first time) or 'adc identity apply' (volume already synced)" \
			test -f "$HOME/.ssh/config"
		check "Claude Code installed" \
			"run 'adc claude upgrade' to bootstrap the shared install volume" \
			have_claude
		check "gh authenticated" \
			"run 'gh auth login' (persists on the shared gh volume)" \
			gh auth status
		check "docker reachable" \
			"docker-in-docker should start with the container — rebuild the container, then check 'docker info'" \
			docker info
	else
		print -r -- "adc doctor (host)"
		check "SSH_AUTH_SOCK points at the 1Password socket" \
			"add to ~/.zshrc: export SSH_AUTH_SOCK=\"\$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock\"" \
			sock_is_1password
		check "SSH agent alive" \
			"enable Settings > Developer > SSH agent in 1Password, then restart the shell" \
			agent_alive
		check "Docker running" \
			"start Docker Desktop (or OrbStack)" \
			docker info
	fi

	if (( doctor_failures > 0 )); then
		print -r -- "$doctor_failures check(s) failed"
		return 1
	fi
	print -r -- "all checks passed"
}

# ---------------------------------------------------------------------------

cmd_identity() {
	(( $# >= 1 )) || { identity_usage; return 0 }
	local sub="$1"
	shift
	case "$sub" in
		sync) cmd_identity_sync "$@" ;;
		apply) cmd_identity_apply "$@" ;;
		-h|--help|help) identity_usage ;;
		*) die "unknown command 'identity $sub' (run 'adc identity --help')" ;;
	esac
}

cmd_claude() {
	(( $# >= 1 )) || { claude_usage; return 0 }
	local sub="$1"
	shift
	case "$sub" in
		upgrade) cmd_claude_upgrade "$@" ;;
		-h|--help|help) claude_usage ;;
		*) die "unknown command 'claude $sub' (run 'adc claude --help')" ;;
	esac
}

main() {
	(( $# >= 1 )) || { usage; exit 1 }
	local cmd="$1"
	shift
	case "$cmd" in
		init) cmd_init "$@" ;;
		identity) cmd_identity "$@" ;;
		claude) cmd_claude "$@" ;;
		doctor) cmd_doctor "$@" ;;
		# v1 flat verbs: hard break, each pointing at its new home
		sync) die "'sync' moved — use 'adc identity sync'" ;;
		apply) die "'apply' moved — use 'adc identity apply'" ;;
		upgrade) die "'upgrade' moved — use 'adc claude upgrade'" ;;
		-h|--help|help) usage ;;
		*) die "unknown command '$cmd' (run 'adc --help')" ;;
	esac
}

main "$@"
